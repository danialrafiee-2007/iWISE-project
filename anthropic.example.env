# The experimental online check (D-141): when the local engine is not sure, its doubtful claims go to Claude, which
# reads the same sources and searches the web. Copy this file to anthropic.local.env (git and Docker ignore that name)
# and put in the team's key from https://console.anthropic.com/settings/keys; or set the same names as environment
# variables. Without a key nothing is ever sent and the app works fully offline.
ANTHROPIC_API_KEY=sk-ant-your-key
# Spending stops for the day once this many dollars (at list prices) have been used. Default 2.
# TG_ONLINE_DAILY_USD=2
