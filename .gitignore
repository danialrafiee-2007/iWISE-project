# Python-generated files
__pycache__/
*.py[oc]
build/
# ...but three.js's own build folder is part of the site: the 3D scenes load it, offline
!**/vendor/three@*/build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Portable runtime made by TruthGuardian.bat setup: uv, Python, package cache and language models (about 2 GB)
runtime/

# The folder the package's starter unpacks into, if a package is ever started from this folder
/TruthGuardian/

# Data and model artifacts (downloaded or generated, never committed)
data/raw/
data/processed/
*.ckpt
*.safetensors
*.onnx

# Secrets (the Contact page's mail account lives in smtp.local.env, an old key file anthropic.local.env if one is left, the
# free online services' keys in free.local.env; the .example.env files show their lines)
.env
smtp.local.env
anthropic.local.env
free.local.env

# Frontend
node_modules/

# Evaluation outputs (results JSON and the locked-run log are committed)
eval/predictions/
eval/*_run.log
data/features/
models/fusion/*/model.joblib
models/tracer/*/model.joblib
!models/fusion/20261022-082833-ensemble/model.joblib
!models/tracer/20261022-083040-tracer/model.joblib
models/onnx/*/
models/detector/
# data/web holds this computer's library and caches; the project's learned examples (D-222) are kept in git.
data/web/*
!data/web/learned_seed.json
layers-originals/
*.tsbuildinfo
