# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Portable runtime made by TruthGuardian.bat setup: uv, Python, package cache and language models (about 2 GB)
runtime/

# Data and model artifacts (downloaded or generated, never committed)
data/raw/
data/processed/
*.ckpt
*.safetensors
*.onnx

# Secrets (the Contact page's mail account lives in smtp.local.env, the online check's key in anthropic.local.env;
# the .example.env files show their lines)
.env
smtp.local.env
anthropic.local.env

# Frontend
node_modules/

# Evaluation outputs (results JSON and the locked-run log are committed)
eval/predictions/
eval/*_run.log
data/features/
models/fusion/*/model.joblib
models/tracer/*/model.joblib
!models/fusion/20261022-082833-ensemble/model.joblib
!models/tracer/20261022-083040-tracer/model.joblib
models/onnx/*/
models/detector/
data/web/
layers-originals/
*.tsbuildinfo
