# The mail account the Contact page sends from. Copy this file to smtp.local.env (git and Docker ignore that name)
# and fill it in; or set the same names as environment variables. Messages always go to majidrafiee1404@gmail.com.
#
# For Gmail: turn on 2-Step Verification, then make an app password at https://myaccount.google.com/apppasswords
# and paste it below (the spaces Google shows are fine). The app reads this file for every message.
TG_SMTP_USER=your.address@gmail.com
TG_SMTP_PASSWORD=your-app-password
# TG_SMTP_HOST=smtp.gmail.com
# TG_SMTP_PORT=587
